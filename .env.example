# Optional for developers. End users should use in-app Settings (gear icon).
# Keys saved in Settings (local app data) override these environment values.
# NEVER commit a real .env — copy this file to .env and fill placeholders only.

# ---------------------------------------------------------------------------
# 1. fal.ai — REQUIRED for almost all generation
#    Image, Video, Tools, Creative Vision, Audio, Frame Editor 1080p proxy.
#    Get a key: https://fal.ai/dashboard/keys
#    Note: top-bar balance display needs an Admin-scoped fal key.
#    Generation works with a normal key even if balance shows “check billing”.
# ---------------------------------------------------------------------------
FAL_KEY=your_fal_key_here
# FAL_API_KEY is also accepted as an alias.

# ---------------------------------------------------------------------------
# 2. xAI / Grok — OPTIONAL
#    Enhance Prompt, QC, scenario suggest (text/vision).
#    Grok Imagine models hosted on fal still use FAL_KEY, not this key.
#    Get a key: https://console.x.ai/team/default/api-keys
# ---------------------------------------------------------------------------
XAI_API_KEY=your_xai_api_key_here

# ---------------------------------------------------------------------------
# 3. Runware — OPTIONAL (Frame Editor / Aleph 2.0 only)
#    Never used for fal Studio / Tools / Audio routes.
#    Get a key: https://my.runware.ai/
# ---------------------------------------------------------------------------
RUNWARE_API_KEY=your_runware_api_key_here
# RUNWARE_KEY is also accepted as an alias.

# Optional overrides
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.5

# Resolve → Studio: optional override if auto-detect fails (neutral example only)
# AI_MEDIA_STUDIO_ROOT=/path/to/ai-media-studio
